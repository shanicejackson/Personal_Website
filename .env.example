# Environment Configuration
# Copy this file to .env and update the values
# IMPORTANT: Never commit .env files with real credentials

# Yahoo Mail SMTP Settings
EMAIL_USER=your_yahoo_email@yahoo.com
EMAIL_PASS=your_app_password_here  # Generate from Yahoo Account Security > App passwords
EMAIL_SERVICE=Yahoo

# Optional: Override recipient (defaults to EMAIL_USER if not set)
# EMAIL_TO=recipient@example.com

# Server Configuration
PORT=5000

# Development Settings
# MOCK_EMAIL=true  # Set to skip sending real emails during testing

# Frontend Configuration (not needed in development due to proxy)
# REACT_APP_API_URL=http://localhost:5000